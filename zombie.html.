
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>PLAYLOOP | Zombie Apocalypse</title>

<style>
*{box-sizing:border-box}
body{
 margin:0;overflow:hidden;background:#080d0c;
 color:white;font-family:Arial,sans-serif
}
#game{width:100vw;height:100vh}
#hud{
 position:fixed;top:12px;left:12px;right:12px;
 display:flex;justify-content:space-between;gap:8px;
 flex-wrap:wrap;pointer-events:none;z-index:5
}
.panel{
 background:rgba(5,13,13,.88);
 border:1px solid #52d68a;border-radius:9px;
 padding:9px 13px;font-size:13px
}
.panel strong{color:#7dffad;font-size:17px}
#healthbar{
 width:125px;height:8px;background:#462323;
 border-radius:8px;margin-top:5px;overflow:hidden
}
#healthfill{height:100%;width:100%;background:#55e68c}
#crosshair{
 position:fixed;left:50%;top:50%;transform:translate(-50%,-50%);
 color:#fff;font-size:28px;pointer-events:none;z-index:4;
 text-shadow:0 0 8px #ff4c4c
}
#overlay{
 position:fixed;inset:0;z-index:10;
 display:flex;align-items:center;justify-content:center;
 background:rgba(0,0,0,.86);padding:18px;text-align:center
}
.card{
 width:min(520px,96vw);padding:28px 22px;
 border:1px solid #56e58d;border-radius:18px;
 background:linear-gradient(145deg,#172c25,#10151a);
 box-shadow:0 0 35px #1d7048
}
h1{color:#83ffad;font-size:32px;margin:5px}
.card p{line-height:1.6;color:#d5e4dc}
button{
 border:0;border-radius:9px;padding:12px 17px;
 font-weight:bold;font-size:14px;cursor:pointer;
 background:#6cff9c;color:#06180e;margin:4px
}
button:disabled{opacity:.5}
#mobile{
 position:fixed;bottom:15px;left:12px;right:12px;
 display:flex;justify-content:space-between;
 z-index:6;pointer-events:none
}
.controls{display:flex;gap:7px}
.controls button{
 width:54px;height:54px;border-radius:50%;
 padding:0;background:rgba(36,75,57,.85);
 color:white;border:1px solid #79ffae;
 pointer-events:auto;touch-action:none
}
#fire{background:#a82e36;width:65px;height:65px}
#reload{background:#344f7a}
#notice{
 position:fixed;bottom:100px;left:50%;
 transform:translateX(-50%);z-index:5;
 background:#101b17;padding:9px 15px;border-radius:8px;
 color:#aaffc5;pointer-events:none
}
.hidden{display:none!important}
</style>
</head>

<body>
<div id="game"></div>

<div id="hud">
 <div class="panel">SCORE<br><strong id="score">0</strong></div>
 <div class="panel">WAVE<br><strong id="wave">1</strong></div>
 <div class="panel">HEALTH<br><strong id="health">100</strong>
  <div id="healthbar"><div id="healthfill"></div></div>
 </div>
 <div class="panel">WEAPON<br><strong id="weapon">PISTOL</strong></div>
 <div class="panel">AMMO<br><strong id="ammo">12 / 60</strong></div>
</div>

<div id="crosshair">+</div>
<div id="notice">WASD move · SHIFT sprint · SPACE shoot · R reload · 1/2/3 weapons</div>

<div id="mobile">
 <div class="controls">
  <button id="left">◀</button>
  <button id="forward">▲</button>
  <button id="back">▼</button>
  <button id="right">▶</button>
 </div>
 <div class="controls">
  <button id="reload">R</button>
  <button id="fire">FIRE</button>
 </div>
</div>

<div id="overlay">
 <div class="card">
  <h1>🧟 ZOMBIE APOCALYPSE</h1>
  <h2>LAST SURVIVOR</h2>
  <p>
   The city has fallen. The infected are hunting.
   Explore the ruined city, fight the zombie hordes,
   collect points and survive as many waves as possible.
  </p>
  <p>
   <b>WASD:</b> Move · <b>SHIFT:</b> Sprint<br>
   <b>SPACE / FIRE:</b> Shoot · <b>R:</b> Reload<br>
   <b>1, 2, 3:</b> Change weapon
  </p>
  <button id="start">ENTER THE APOCALYPSE</button>
 </div>
</div>

<script type="importmap">
{
 "imports":{
  "three":"https://cdn.jsdelivr.net/npm/three@0.160.0/build/three.module.js"
 }
}
</script>

<script type="module">
import * as THREE from "three";

const container=document.getElementById("game");
const scene=new THREE.Scene();
scene.background=new THREE.Color(0x17221f);
scene.fog=new THREE.FogExp2(0x17221f,0.008);

const camera=new THREE.PerspectiveCamera(
 70,window.innerWidth/window.innerHeight,0.1,700
);

const renderer=new THREE.WebGLRenderer({antialias:true});
renderer.setSize(window.innerWidth,window.innerHeight);
renderer.setPixelRatio(Math.min(window.devicePixelRatio,2));
renderer.shadowMap.enabled=true;
renderer.shadowMap.type=THREE.PCFSoftShadowMap;
container.appendChild(renderer.domElement);

scene.add(new THREE.HemisphereLight(0xa9c5b0,0x252a24,2));

const sunlight=new THREE.DirectionalLight(0xc9e3c9,2.1);
sunlight.position.set(-50,100,40);
sunlight.castShadow=true;
sunlight.shadow.mapSize.set(2048,2048);
scene.add(sunlight);

// WORLD
const ground=new THREE.Mesh(
 new THREE.PlaneGeometry(500,500),
 new THREE.MeshStandardMaterial({color:0x343b34,roughness:1})
);
ground.rotation.x=-Math.PI/2;
ground.position.y=-0.15;
ground.receiveShadow=true;
scene.add(ground);

// Roads
function box(x,y,z,sx,sy,sz,color){
 const mesh=new THREE.Mesh(
  new THREE.BoxGeometry(sx,sy,sz),
  new THREE.MeshStandardMaterial({color,roughness:.9})
 );
 mesh.position.set(x,y,z);
 mesh.castShadow=true;
 mesh.receiveShadow=true;
 scene.add(mesh);
 return mesh;
}

box(0,-.08,0,15,.08,450,0x252b2a);
box(0,-.07,0,450,.08,15,0x252b2a);

for(let i=-210;i<=210;i+=12){
 box(0,-.025,i,.18,.025,4,0xb4a66c);
 box(i,-.02,0,4,.025,.18,0xb4a66c);
}

// Abandoned buildings
const buildingColors=[0x555b55,0x484b50,0x5c5148,0x373f43];

for(let x=-190;x<=190;x+=35){
 for(let z=-190;z<=190;z+=35){
  if(Math.abs(x)<18||Math.abs(z)<18)continue;

  const sx=12+Math.random()*12;
  const sz=12+Math.random()*12;
  const sy=9+Math.random()*22;

  const b=box(
   x+(Math.random()-.5)*7,sy/2,z+(Math.random()-.5)*7,
   sx,sy,sz,
   buildingColors[Math.floor(Math.random()*buildingColors.length)]
  );

  const windows=new THREE.Mesh(
   new THREE.BoxGeometry(sx*.7,.35,.12),
   new THREE.MeshBasicMaterial({color:0x8c7650})
  );
  windows.position.set(0,sy*.3,sz/2+.07);
  b.add(windows);
 }
}

// Trees and debris
function tree(x,z){
 const trunk=box(x,2,z,.8,4,.8,0x55402b);
 const leaves=new THREE.Mesh(
  new THREE.ConeGeometry(3,8,7),
  new THREE.MeshStandardMaterial({color:0x294c35})
 );
 leaves.position.set(x,7,z);
 leaves.castShadow=true;
 scene.add(leaves);
}

for(let i=0;i<100;i++){
 const x=(Math.random()-.5)*420;
 const z=(Math.random()-.5)*420;
 if(Math.abs(x)<13||Math.abs(z)<13)continue;
 tree(x,z);
}

for(let i=0;i<150;i++){
 const x=(Math.random()-.5)*400;
 const z=(Math.random()-.5)*400;
 if(Math.abs(x)<12&&Math.abs(z)<12)continue;
 box(x,.25,z,.5+Math.random()*2,.4,.5+Math.random()*2,0x4b4b42);
}

// PLAYER
const player=new THREE.Group();
scene.add(player);

const bodyMat=new THREE.MeshStandardMaterial({color:0x263e35});
const skinMat=new THREE.MeshStandardMaterial({color:0xc28e70});

const torso=new THREE.Mesh(
 new THREE.BoxGeometry(1.1,1.5,.65),bodyMat
);
torso.position.y=1.65;
player.add(torso);

const head=new THREE.Mesh(
 new THREE.SphereGeometry(.38,16,16),skinMat
);
head.position.y=2.65;
player.add(head);

for(const side of [-1,1]){
 const leg=new THREE.Mesh(
  new THREE.BoxGeometry(.38,1,.45),
  new THREE.MeshStandardMaterial({color:0x242b32})
 );
 leg.position.set(side*.3,.55,0);
 player.add(leg);

 const arm=new THREE.Mesh(
  new THREE.BoxGeometry(.3,1.1,.35),bodyMat
 );
 arm.position.set(side*.72,1.7,-.05);
 player.add(arm);
}

player.position.set(0,0,0);

let direction=0;

// WEAPONS
const weapons=[
 {name:"PISTOL",capacity:12,ammo:12,reserve:60,damage:45,rate:.35,range:65},
 {name:"SHOTGUN",capacity:6,ammo:6,reserve:36,damage:32,rate:.85,range:28},
 {name:"ASSAULT RIFLE",capacity:30,ammo:30,reserve:150,damage:25,rate:.11,range:85}
];

let selected=0;
let fireCooldown=0;
let reloading=false;
let reloadTimer=0;

function currentWeapon(){return weapons[selected]}

function updateHUD(){
 document.getElementById("score").textContent=score;
 document.getElementById("wave").textContent=wave;
 document.getElementById("health").textContent=Math.ceil(health);
 document.getElementById("healthfill").style.width=health+"%";
 document.getElementById("weapon").textContent=currentWeapon().name;
 document.getElementById("ammo").textContent=
  currentWeapon().ammo+" / "+currentWeapon().reserve;
}

let score=0;
let health=100;
let wave=1;
let running=false;
let gameEnded=false;

function switchWeapon(n){
 if(n<0||n>=weapons.length)return;
 selected=n;
 reloading=false;
 updateHUD();
}

// ZOMBIES
let zombies=[];
let bullets=[];
let particles=[];
let spawnTimer=0;
let waveKills=0;
let requiredKills=8;

const zombieMaterials=[
 new THREE.MeshStandardMaterial({color:0x668b58}),
 new THREE.MeshStandardMaterial({color:0x9a694d}),
 new THREE.MeshStandardMaterial({color:0x526d80}),
 new THREE.MeshStandardMaterial({color:0x6c526c})
];

function createZombie(boss=false){
 const z=new THREE.Group();
 const material=boss
  ? new THREE.MeshStandardMaterial({color:0x541e27})
  : zombieMaterials[Math.floor(Math.random()*zombieMaterials.length)];

 const torso=new THREE.Mesh(
  new THREE.BoxGeometry(boss?1.5:.85,boss?2.1:1.45,.6),material
 );
 torso.position.y=boss?2:1.5;
 z.add(torso);

 const head=new THREE.Mesh(
  new THREE.SphereGeometry(boss?.55:.36,12,12),material
 );
 head.position.y=boss?3.35:2.55;
 z.add(head);

 for(const side of [-1,1]){
  const arm=new THREE.Mesh(
   new THREE.BoxGeometry(.28,boss?1.5:1.05,.3),material
  );
  arm.position.set(side*(boss? .9:.58),1.8,-.05);
  arm.rotation.z=side*.2;
  z.add(arm);

  const leg=new THREE.Mesh(
   new THREE.BoxGeometry(.34,1,.4),material
  );
  leg.position.set(side*.23,.5,0);
  z.add(leg);
 }

 const angle=Math.random()*Math.PI*2;
 const distance=35+Math.random()*45;

 z.position.set(
  player.position.x+Math.sin(angle)*distance,
  0,
  player.position.z+Math.cos(angle)*distance
 );

 z.userData={
  hp:boss?500:100+wave*8,
  speed:boss?2.1:1.3+Math.random()*.7+wave*.045,
  damage:boss?18:8,
  boss,
  attack:0,
  wobble:Math.random()*6
 };

 scene.add(z);
 zombies.push(z);
}

function spawnWave(){
 const amount=4+wave*2;
 for(let i=0;i<amount;i++){
  setTimeout(()=>{
   if(running){
    createZombie(false);
   }
  },i*500);
 }

 if(wave%5===0){
  setTimeout(()=>{
   if(running)createZombie(true);
  },amount*500);
 }
}

// EFFECTS
function burst(position,color=0xffa64d,count=12){
 for(let i=0;i<count;i++){
  const mesh=new THREE.Mesh(
   new THREE.SphereGeometry(.09,6,6),
   new THREE.MeshBasicMaterial({color})
  );
  mesh.position.copy(position);
  scene.add(mesh);

  particles.push({
   mesh,
   velocity:new THREE.Vector3(
    (Math.random()-.5)*.35,
    Math.random()*.3,
    (Math.random()-.5)*.35
   ),
   life:35
  });
 }
}

function tracer(start,end){
 const geometry=new THREE.BufferGeometry().setFromPoints([start,end]);
 const line=new THREE.Line(
  geometry,
  new THREE.LineBasicMaterial({color:0xffe18a})
 );
 scene.add(line);
 bullets.push({mesh:line,life:5});
}

// SHOOTING
function shoot(){
 if(!running||reloading||fireCooldown>0)return;

 const weapon=currentWeapon();

 if(weapon.ammo<=0){
  document.getElementById("notice").textContent="OUT OF AMMO — PRESS R";
  return;
 }

 weapon.ammo--;
 fireCooldown=weapon.rate;

 const forward=new THREE.Vector3(
  Math.sin(direction),0,-Math.cos(direction)
 );

 const origin=player.position.clone();
 origin.y=1.8;

 const shots=selected===1?5:1;
 let hitAny=false;

 for(let s=0;s<shots;s++){
  let best=null;
  let bestDistance=weapon.range;

  for(const zombie of zombies){
   const target=zombie.position.clone();
   target.y=1.5;

   const difference=target.clone().sub(origin);
   const distance=difference.length();
   difference.normalize();

   const accuracy=selected===1?.90:.975;

   if(forward.dot(difference)>accuracy&&distance<bestDistance){
    best=zombie;
    bestDistance=distance;
   }
  }

  const spread=selected===1?(Math.random()-.5)*.17:0;
  const shotDirection=forward.clone();
  shotDirection.x+=spread;
  shotDirection.normalize();

  const end=origin.clone().add(shotDirection.multiplyScalar(
   best?bestDistance:weapon.range
  ));

  tracer(origin,end);

  if(best){
   best.userData.hp-=weapon.damage;
   burst(best.position.clone().add(new THREE.Vector3(0,1.5,0)),0xffaa55,5);
   hitAny=true;

   if(best.userData.hp<=0){
    burst(best.position.clone().add(new THREE.Vector3(0,1.5,0)),0xff6b35,22);
    scene.remove(best);
    zombies=zombies.filter(z=>z!==best);
    score+=best.userData.boss?1000:100;
    waveKills++;
   }
  }
 }

 updateHUD();
}

function reload(){
 const w=currentWeapon();

 if(reloading||w.ammo===w.capacity||w.reserve<=0)return;

 reloading=true;
 reloadTimer=selected===1?1.7:selected===2?2.2:1.3;
 document.getElementById("notice").textContent="RELOADING...";
}

// INPUT
const keys={};

window.addEventListener("keydown",e=>{
 keys[e.code]=true;

 if(["Space","ArrowUp","ArrowDown","ArrowLeft","ArrowRight"].includes(e.code)){
  e.preventDefault();
 }

 if(e.code==="Digit1")switchWeapon(0);
 if(e.code==="Digit2")switchWeapon(1);
 if(e.code==="Digit3")switchWeapon(2);
 if(e.code==="KeyR")reload();
});

window.addEventListener("keyup",e=>keys[e.code]=false);

function hold(id,key){
 const el=document.getElementById(id);
 el.addEventListener("pointerdown",e=>{
  e.preventDefault();keys[key]=true;
 });
 ["pointerup","pointerleave","pointercancel"].forEach(type=>{
  el.addEventListener(type,()=>keys[key]=false);
 });
}

hold("left","KeyA");
hold("right","KeyD");
hold("forward","KeyW");
hold("back","KeyS");
hold("fire","Space");

document.getElementById("reload").addEventListener("click",reload);
document.getElementById("start").addEventListener("click",startGame);

// GAME FLOW
function startGame(){
 zombies.forEach(z=>scene.remove(z));
 particles.forEach(p=>scene.remove(p.mesh));
 bullets.forEach(b=>scene.remove(b.mesh));

 zombies=[];
 particles=[];
 bullets=[];

 player.position.set(0,0,0);
 direction=0;
 score=0;
 health=100;
 wave=1;
 waveKills=0;
 requiredKills=8;
 spawnTimer=0;
 selected=0;

 weapons[0].ammo=12;weapons[0].reserve=60;
 weapons[1].ammo=6;weapons[1].reserve=36;
 weapons[2].ammo=30;weapons[2].reserve=150;

 running=true;
 gameEnded=false;
 reloading=false;

 document.getElementById("overlay").classList.add("hidden");
 updateHUD();
 spawnWave();
}

function endGame(){
 running=false;
 gameEnded=true;

 document.getElementById("overlay").classList.remove("hidden");
 document.querySelector("#overlay h1").textContent="☠️ YOU WERE OVERRUN";
 document.querySelector("#overlay h2").textContent="FINAL SCORE: "+score;
 document.querySelector("#overlay .card p").textContent=
  "You survived until wave "+wave+". The city still needs a survivor. Try again!";
 document.getElementById("start").textContent="PLAY AGAIN";
}

// MAIN LOOP
const clock=new THREE.Clock();

function animate(){
 requestAnimationFrame(animate);

 const dt=Math.min(clock.getDelta(),.04);

 if(running){
  // PLAYER MOVEMENT AND ROTATION
  const turnSpeed=2.3*dt;
  if(keys.KeyA||keys.ArrowLeft)direction+=turnSpeed;
  if(keys.KeyD||keys.ArrowRight)direction-=turnSpeed;

  const forward=keys.KeyW||keys.ArrowUp;
  const backward=keys.KeyS||keys.ArrowDown;
  const sprint=keys.ShiftLeft||keys.ShiftRight;

  const speed=sprint?12:7;
  const movement=forward?1:backward?-.65:0;

  player.position.x+=Math.sin(direction)*speed*movement*dt;
  player.position.z-=Math.cos(direction)*speed*movement*dt;

  player.position.x=THREE.MathUtils.clamp(player.position.x,-235,235);
  player.position.z=THREE.MathUtils.clamp(player.position.z,-235,235);

  player.rotation.y=direction;

  if(keys.Space)shoot();

  fireCooldown=Math.max(0,fireCooldown-dt);

  if(reloading){
   reloadTimer-=dt;
   if(reloadTimer<=0){
    const w=currentWeapon();
    const needed=w.capacity-w.ammo;
    const amount=Math.min(needed,w.reserve);
    w.ammo+=amount;
    w.reserve-=amount;
    reloading=false;
    document.getElementById("notice").textContent="READY — KEEP SURVIVING";
   }
  }

  // ZOMBIE PURSUIT
  for(const zombie of zombies){
   const dx=player.position.x-zombie.position.x;
   const dz=player.position.z-zombie.position.z;
   const distance=Math.sqrt(dx*dx+dz*dz);

   if(distance>1.6){
    zombie.position.x+=(dx/distance)*zombie.userData.speed*dt;
    zombie.position.z+=(dz/distance)*zombie.userData.speed*dt;
   }else{
    zombie.userData.attack-=dt;
    if(zombie.userData.attack<=0){
     health-=zombie.userData.damage;
     zombie.userData.attack=.8;
     burst(player.position.clone().add(new THREE.Vector3(0,1,0)),0xff4433,4);
    }
   }

   zombie.rotation.y=Math.atan2(dx,dz);
   zombie.position.y=Math.abs(Math.sin(performance.now()*.008+zombie.userData.wobble))*.12;
  }

  // WAVE PROGRESSION
  if(waveKills>=requiredKills&&zombies.length===0){
   wave++;
   waveKills=0;
   requiredKills=8+wave*3;
   health=Math.min(100,health+12);
   spawnWave();
  }

  // PARTICLES
  particles.forEach(p=>{
   p.mesh.position.addScaledVector(p.velocity,dt*25);
   p.life--;
  });

  particles=particles.filter(p=>{
   if(p.life<=0){
    scene.remove(p.mesh);
    return false;
   }
   return true;
  });

  bullets.forEach(b=>b.life--);
  bullets=bullets.filter(b=>{
   if(b.life<=0){
    scene.remove(b.mesh);
    return false;
   }
   return true;
  });

  health=Math.max(0,health);
  updateHUD();

  if(health<=0)endGame();
 }

 // THIRD-PERSON CHASE CAMERA
 const cameraOffset=new THREE.Vector3(
  Math.sin(direction)*13,
  7,
  Math.cos(direction)*13
 );

 const desiredCamera=player.position.clone().add(cameraOffset);
 camera.position.lerp(desiredCamera,.09);

 const lookAt=player.position.clone().add(
  new THREE.Vector3(0,2,-Math.cos(direction)*5)
 );

 camera.lookAt(lookAt);

 renderer.render(scene,camera);
}

animate();

window.addEventListener("resize",()=>{
 camera.aspect=window.innerWidth/window.innerHeight;
 camera.updateProjectionMatrix();
 renderer.setSize(window.innerWidth,window.innerHeight);
});
</script>
</body>
</html>
