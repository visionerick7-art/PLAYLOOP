
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Zombie Apocalypse | PLAYLOOP</title>
<style>
*{box-sizing:border-box}
body{margin:0;background:#080d12;color:white;font-family:Arial,sans-serif;overflow:hidden}
canvas{display:block}
#hud{position:fixed;top:12px;left:12px;right:12px;z-index:5;display:flex;gap:8px;flex-wrap:wrap}
.stat{background:#101b25eF;border:1px solid #3d7d67;padding:9px 12px;border-radius:9px;font-size:13px}
#mission{position:fixed;top:68px;left:12px;z-index:5;background:#101b25eF;padding:10px 14px;border-radius:8px;font-size:13px}
#message{position:fixed;top:125px;left:50%;transform:translateX(-50%);z-index:8;background:#182a20;padding:12px 20px;border-radius:9px;opacity:0;transition:opacity .2s;pointer-events:none}
#overlay{position:fixed;inset:0;z-index:20;background:linear-gradient(140deg,#080d12ed,#30150ded);display:flex;align-items:center;justify-content:center;padding:18px;text-align:center}
.panel{max-width:550px;background:#101b25f5;border:1px solid #55a783;border-radius:18px;padding:28px;box-shadow:0 0 45px #36b77b30}
.panel h1{font-size:clamp(30px,6vw,52px);color:#8bffb7;margin:0 0 12px}
.panel p{line-height:1.7;color:#d6e4dc}
button{border:0;border-radius:9px;padding:12px 17px;background:linear-gradient(90deg,#167b50,#43c77c);color:white;font-weight:bold;cursor:pointer}
#controls{display:none;position:fixed;bottom:14px;left:12px;right:12px;z-index:10;justify-content:space-between;align-items:end;pointer-events:none}
.pad,.actions{display:grid;gap:6px;pointer-events:auto}
.pad{grid-template-columns:repeat(3,45px);grid-template-rows:repeat(2,42px)}
.actions{grid-template-columns:repeat(2,65px)}
.control{padding:8px 3px;background:#172c27eF;border:1px solid #70d6a1;touch-action:none;font-size:11px}
.up{grid-column:2}.left{grid-column:1;grid-row:2}.down{grid-column:2;grid-row:2}.right{grid-column:3;grid-row:2}
@media(max-width:800px),(pointer:coarse){#controls{display:flex}.stat{font-size:11px;padding:7px}#mission{top:65px;font-size:11px}}
</style>
</head>
<body>

<div id="hud">
 <div class="stat">❤️ <span id="health">100</span></div>
 <div class="stat">⭐ Score: <span id="score">0</span></div>
 <div class="stat">☠️ Kills: <span id="kills">0</span></div>
 <div class="stat">🌊 Wave: <span id="wave">1</span></div>
 <div class="stat">🔫 <span id="weapon">PISTOL</span></div>
 <div class="stat">💥 Ammo: <span id="ammo">12/12</span></div>
</div>

<div id="mission">SURVIVE THE APOCALYPSE — Eliminate the incoming zombies!</div>
<div id="message"></div>

<div id="overlay">
 <div class="panel">
  <h1>🧟 ZOMBIE APOCALYPSE</h1>
  <p>The city has fallen. Survive the infected, collect your courage, and fight through increasingly dangerous waves.</p>
  <p><b>CONTROLS</b><br>
  WASD / Arrow keys: Move<br>
  Mouse click / SPACE: Shoot<br>
  SHIFT: Sprint | R: Reload<br>
  1: Pistol | 2: Shotgun | 3: Assault rifle</p>
  <button id="startButton">ENTER THE APOCALYPSE</button>
 </div>
</div>

<div id="controls">
 <div class="pad">
  <button class="control up" data-key="w">▲</button>
  <button class="control left" data-key="a">◀</button>
  <button class="control down" data-key="s">▼</button>
  <button class="control right" data-key="d">▶</button>
 </div>
 <div class="actions">
  <button class="control" data-action="shoot">🔥 FIRE</button>
  <button class="control" data-action="reload">↻ RELOAD</button>
  <button class="control" data-action="sprint">⚡ SPRINT</button>
  <button class="control" data-action="switch">🔫 SWITCH</button>
 </div>
</div>

<script type="module">
import * as THREE from
"https://cdn.jsdelivr.net/npm/three@0.160.0/build/three.module.js";

/* =========================
   CORE ENGINE
========================= */

const scene=new THREE.Scene();
scene.background=new THREE.Color(0x111a20);
scene.fog=new THREE.Fog(0x111a20,35,115);

const camera=new THREE.PerspectiveCamera(
 65,innerWidth/innerHeight,.1,180
);

const renderer=new THREE.WebGLRenderer({
 antialias:true,
 powerPreference:"high-performance"
});
renderer.setSize(innerWidth,innerHeight);
renderer.setPixelRatio(Math.min(devicePixelRatio,1.5));
renderer.outputColorSpace=THREE.SRGBColorSpace;
document.body.appendChild(renderer.domElement);

scene.add(new THREE.HemisphereLight(0x9ab6bd,0x252019,1.8));

const sunlight=new THREE.DirectionalLight(0xd6e6d5,2);
sunlight.position.set(-30,45,20);
scene.add(sunlight);

const clock=new THREE.Clock();

const mat=(color,roughness=.9)=>new THREE.MeshStandardMaterial({
 color,roughness
});

const groundMat=mat(0x343b37);
const roadMat=mat(0x171c20);
const buildingMat=mat(0x53504b);
const zombieMat=mat(0x668b52);
const darkMat=mat(0x222a28);

const boxGeo=new THREE.BoxGeometry(1,1,1);

/* =========================
   CITY ENVIRONMENT
========================= */

const ground=new THREE.Mesh(
 new THREE.PlaneGeometry(160,160),groundMat
);
ground.rotation.x=-Math.PI/2;
ground.position.y=-.12;
scene.add(ground);

function makeBox(x,y,z,sx,sy,sz,material){
 const m=new THREE.Mesh(boxGeo,material);
 m.position.set(x,y,z);
 m.scale.set(sx,sy,sz);
 scene.add(m);
 return m;
}

// Roads
makeBox(0,-.045,0,160,.05,13,roadMat);
makeBox(0,-.04,0,13,.05,160,roadMat);

// Road markings
for(let i=-70;i<=70;i+=10){
 makeBox(i,.0,0,4,.025,.18,mat(0xb5a76c));
 makeBox(0,.0,i,.18,.025,4,mat(0xb5a76c));
}

// City buildings
const buildings=[];
for(let x=-65;x<=65;x+=15){
 for(let z=-65;z<=65;z+=15){
  if(Math.abs(x)<12||Math.abs(z)<12)continue;

  const w=7+Math.random()*4;
  const h=5+Math.random()*17;
  const d=7+Math.random()*4;

  const building=makeBox(
   x,h/2,z,w,h,d,
   mat([0x454b50,0x514a43,0x393f46,0x5a5147][Math.floor(Math.random()*4)])
  );

  buildings.push(building);

  // Rooftop detail
  makeBox(x,h+.4,z,w*.25,.8,d*.25,darkMat);
 }
}

// Trees and street debris
function tree(x,z){
 const trunk=new THREE.Mesh(
  new THREE.CylinderGeometry(.2,.3,2,7),
  mat(0x62442e)
 );
 trunk.position.set(x,1,z);
 scene.add(trunk);

 const crown=new THREE.Mesh(
  new THREE.SphereGeometry(1.3,8,7),
  mat(0x304c34)
 );
 crown.position.set(x,2.6,z);
 scene.add(crown);
}

for(let i=0;i<40;i++){
 const x=(Math.random()-.5)*130;
 const z=(Math.random()-.5)*130;
 if(Math.abs(x)<12||Math.abs(z)<12)continue;
 tree(x,z);
}

// Random debris
for(let i=0;i<65;i++){
 const x=(Math.random()-.5)*130;
 const z=(Math.random()-.5)*130;
 const debris=makeBox(
  x,.25,z,.4+Math.random(),.5,.4+Math.random(),
  mat(0x484b45)
 );
 debris.rotation.y=Math.random()*3;
}

/* =========================
   PLAYER
========================= */

const player=new THREE.Group();
scene.add(player);
player.position.set(0,0,8);

const body=new THREE.Mesh(
 new THREE.CylinderGeometry(.42,.48,1.3,10),
 mat(0x263b45)
);
body.position.y=1;
player.add(body);

const head=new THREE.Mesh(
 new THREE.SphereGeometry(.34,12,10),
 mat(0xc48d6b)
);
head.position.y=1.85;
player.add(head);

const backpack=new THREE.Mesh(
 new THREE.BoxGeometry(.65,.8,.35),
 mat(0x253b30)
);
backpack.position.set(0,1.05,-.35);
player.add(backpack);

let health=100;
let score=0;
let kills=0;
let wave=1;
let running=false;
let gameOver=false;
let sprinting=false;

const keys={w:false,a:false,s:false,d:false};

const zombies=[];
const bullets=[];
const effects=[];

const playerDirection=new THREE.Vector3(0,0,-1);

/* =========================
   WEAPONS
========================= */

const weapons=[
 {name:"PISTOL",capacity:12,ammo:12,damage:35,rate:.35,reload:1.1,pellets:1},
 {name:"SHOTGUN",capacity:6,ammo:6,damage:24,rate:.85,reload:1.5,pellets:6},
 {name:"ASSAULT",capacity:30,ammo:30,damage:20,rate:.12,reload:1.8,pellets:1}
];

let weaponIndex=0;
let fireCooldown=0;
let reloadTimer=0;
let shooting=false;

function currentWeapon(){return weapons[weaponIndex]}

function switchWeapon(index){
 weaponIndex=(index+3)%3;
 reloadTimer=0;
 updateHUD();
 say("WEAPON: "+currentWeapon().name);
}

function reload(){
 const w=currentWeapon();
 if(reloadTimer>0||w.ammo===w.capacity)return;
 reloadTimer=w.reload;
 say("RELOADING...");
}

/* =========================
   ZOMBIE CHARACTER FACTORY
========================= */

function createZombie(x,z,type="walker"){
 const group=new THREE.Group();

 const isBoss=type==="boss";
 const isRunner=type==="runner";

 const skin=mat(isBoss?0x742c32:isRunner?0x9d9a54:0x668b52);

 const torso=new THREE.Mesh(
  new THREE.CylinderGeometry(
   isBoss?.75:.4,isBoss?.85:.48,isBoss?2.2:1.35,9
  ),skin
 );
 torso.position.y=isBoss?1.8:1.05;
 group.add(torso);

 const head=new THREE.Mesh(
  new THREE.SphereGeometry(isBoss?.65:.34,10,9),
  mat(0x87916a)
 );
 head.position.y=isBoss?3.2:1.95;
 group.add(head);

 const eyeMat=new THREE.MeshBasicMaterial({color:0xff2525});
 for(const side of [-1,1]){
  const eye=new THREE.Mesh(
   new THREE.SphereGeometry(.07,6,6),eyeMat
  );
  eye.position.set(side*.13,isBoss?3.3:2.0,.28);
  group.add(eye);
 }

 for(const side of [-1,1]){
  const arm=new THREE.Mesh(
   new THREE.CylinderGeometry(.13,.19,isBoss?1.8:1.1,7),
   skin
  );
  arm.position.set(side*(isBoss?1:.5),isBoss?1.9:1.1,.15);
  arm.rotation.z=side*.25;
  group.add(arm);
 }

 group.position.set(x,0,z);
 scene.add(group);

 return {
  group,
  type,
  hp:isBoss?650:isRunner?65:90,
  maxHP:isBoss?650:isRunner?65:90,
  speed:isBoss?1.65:isRunner?3.5:1.8,
  damage:isBoss?24:isRunner?12:8,
  attack:0,
  alive:true,
  bob:Math.random()*6
 };
}

/* =========================
   ZOMBIE WAVES
========================= */

let waveRemaining=0;
let spawnTimer=0;
let bossSpawned=false;

function spawnWave(){
 waveRemaining=5+wave*3;
 bossSpawned=false;

 if(wave%5===0){
  const boss=createZombie(
   player.position.x+12,
   player.position.z-15,
   "boss"
  );
  zombies.push(boss);
  bossSpawned=true;
  say("WARNING! BOSS INCOMING!");
 }else{
  say("WAVE "+wave+" — ZOMBIES APPROACH!");
 }

 document.getElementById("mission").textContent=
  "SURVIVE WAVE "+wave+" — Eliminate every infected enemy!";
}

function spawnZombie(){
 if(waveRemaining<=0)return;

 const angle=Math.random()*Math.PI*2;
 const distance=24+Math.random()*12;

 const x=player.position.x+Math.cos(angle)*distance;
 const z=player.position.z+Math.sin(angle)*distance;

 const type=Math.random()<Math.min(.4,.12+wave*.025)
  ?"runner":"walker";

 zombies.push(createZombie(x,z,type));
 waveRemaining--;
}

function updateWaves(dt){
 spawnTimer-=dt;

 if(waveRemaining>0&&spawnTimer<=0){
  spawnZombie();
  spawnTimer=Math.max(.35,1.6-wave*.07);
 }

 const normalEnemies=zombies.filter(z=>z.alive).length;

 if(waveRemaining===0&&normalEnemies===0){
  wave++;
  health=Math.min(100,health+15);
  updateHUD();
  spawnWave();
 }
}

/* =========================
   COMBAT AND HIT EFFECTS
========================= */

function burst(position,color=0xff6633){
 for(let i=0;i<8;i++){
  const mesh=new THREE.Mesh(
   new THREE.SphereGeometry(.07,6,6),
   new THREE.MeshBasicMaterial({color})
  );
  mesh.position.copy(position);
  scene.add(mesh);

  effects.push({
   mesh,
   life:.45,
   velocity:new THREE.Vector3(
    (Math.random()-.5)*5,
    Math.random()*4,
    (Math.random()-.5)*5
   )
  });
 }
}

function shoot(){
 if(!running||gameOver||fireCooldown>0||reloadTimer>0)return;

 const w=currentWeapon();

 if(w.ammo<=0){
  say("OUT OF AMMO — RELOAD!");
  reload();
  return;
 }

 w.ammo--;
 fireCooldown=w.rate;

 const origin=player.position.clone();
 origin.y=1.4;

 const forward=new THREE.Vector3(
  Math.sin(player.rotation.y),0,
  Math.cos(player.rotation.y)
 );

 for(let pellet=0;pellet<w.pellets;pellet++){
  const direction=forward.clone();

  if(w.pellets>1){
   direction.x+=(Math.random()-.5)*.45;
   direction.z+=(Math.random()-.5)*.45;
   direction.normalize();
  }

  const bullet=new THREE.Mesh(
   new THREE.SphereGeometry(.075,6,6),
   new THREE.MeshBasicMaterial({color:0xffe18a})
  );

  bullet.position.copy(origin);
  scene.add(bullet);

  bullets.push({
   mesh:bullet,
   direction,
   life:1.3,
   damage:w.damage
  });
 }

 updateHUD();
}

function updateBullets(dt){
 for(let i=bullets.length-1;i>=0;i--){
  const b=bullets[i];

  b.mesh.position.addScaledVector(b.direction,45*dt);
  b.life-=dt;

  let remove=b.life<=0;

  for(const z of zombies){
   if(!z.alive)continue;

   const hitPoint=z.group.position.clone();
   hitPoint.y+=z.type==="boss"?2:1.3;

   if(b.mesh.position.distanceTo(hitPoint)<(z.type==="boss"?1.5:1)){
    z.hp-=b.damage;
    burst(hitPoint,0xff5544);
    remove=true;

    if(z.hp<=0){
     z.alive=false;
     z.group.visible=false;
     kills++;
     score+=z.type==="boss"?1500:z.type==="runner"?180:100;

     if(z.type==="boss")say("BOSS ELIMINATED!");
     else say("ZOMBIE ELIMINATED!");

     updateHUD();
    }
    break;
   }
  }

  if(remove){
   scene.remove(b.mesh);
   bullets.splice(i,1);
  }
 }
}

/* =========================
   ZOMBIE AI
========================= */

function updateZombies(dt){
 for(const z of zombies){
  if(!z.alive)continue;

  const dx=player.position.x-z.group.position.x;
  const dz=player.position.z-z.group.position.z;
  const distance=Math.sqrt(dx*dx+dz*dz);

  z.bob+=dt*5;
  z.group.position.y=Math.abs(Math.sin(z.bob))*.08;

  if(distance>1.6){
   const direction=new THREE.Vector3(dx,0,dz).normalize();
   z.group.position.addScaledVector(direction,z.speed*dt);
   z.group.rotation.y=Math.atan2(direction.x,direction.z);
  }else{
   z.attack-=dt;

   if(z.attack<=0){
    z.attack=z.type==="boss"?1.1:.9;
    health-=z.damage;
    burst(player.position.clone().add(new THREE.Vector3(0,1,0)),0xff2222);
    say("ZOMBIE ATTACK!");
    updateHUD();

    if(health<=0)finish(false);
   }
  }
 }
}

/* =========================
   PLAYER MOVEMENT
========================= */

function movePlayer(dt){
 let x=0,z=0;

 if(keys.a)x-=1;
 if(keys.d)x+=1;
 if(keys.w)z-=1;
 if(keys.s)z+=1;

 const direction=new THREE.Vector3(x,0,z);

 if(direction.lengthSq()>0){
  direction.normalize();

  const speed=sprinting?10:5.5;

  player.position.addScaledVector(direction,speed*dt);
  player.rotation.y=Math.atan2(direction.x,direction.z);
 }
 
 player.position.x=THREE.MathUtils.clamp(player.position.x,-76,76);
 player.position.z=THREE.MathUtils.clamp(player.position.z,-76,76);
}

/* =========================
   CAMERA
========================= */

function updateCamera(dt){
 const offset=new THREE.Vector3(
  0,7,10
 ).applyAxisAngle(
  new THREE.Vector3(0,1,0),player.rotation.y
 );

 const target=player.position.clone().add(offset);
 camera.position.lerp(target,Math.min(1,dt*5));

 const look=player.position.clone();
 look.y+=1.1;
 camera.lookAt(look);
}

/* =========================
   PARTICLES
========================= */

function updateEffects(dt){
 for(let i=effects.length-1;i>=0;i--){
  const e=effects[i];
  e.life-=dt;
  e.mesh.position.addScaledVector(e.velocity,dt);
  e.velocity.y-=4*dt;

  if(e.life<=0){
   scene.remove(e.mesh);
   e.mesh.geometry.dispose();
   e.mesh.material.dispose();
   effects.splice(i,1);
  }
 }
}

/* =========================
   HUD AND MESSAGES
========================= */

let messageTimer=0;

function say(text){
 const el=document.getElementById("message");
 el.textContent=text;
 el.style.opacity=1;
 messageTimer=1.7;
}

function updateHUD(){
 document.getElementById("health").textContent=Math.max(0,Math.floor(health));
 document.getElementById("score").textContent=score;
 document.getElementById("kills").textContent=kills;
 document.getElementById("wave").textContent=wave;
 document.getElementById("weapon").textContent=currentWeapon().name;
 document.getElementById("ammo").textContent=
  currentWeapon().ammo+"/"+currentWeapon().capacity;
}

/* =========================
   GAME END AND RESET
========================= */

function finish(won){
 if(gameOver)return;

 gameOver=true;
 running=false;

 document.querySelector("#overlay h1").textContent=
  won?"🏆 SURVIVOR!":"☠️ GAME OVER";

 document.querySelector("#overlay p").innerHTML=
  (won?"CITY SECURED!":"YOU HAVE BEEN OVERRUN!")+
  "<br><br>Score: "+score+
  "<br>Zombies defeated: "+kills+
  "<br>Waves survived: "+wave;

 document.getElementById("startButton").textContent="PLAY AGAIN";
 document.getElementById("overlay").style.display="flex";
}

function resetGame(){
 health=100;
 score=0;
 kills=0;
 wave=1;
 gameOver=false;
 running=true;
 sprinting=false;

 player.position.set(0,0,8);
 player.rotation.y=0;

 for(const z of zombies)scene.remove(z.group);
 for(const b of bullets)scene.remove(b.mesh);
 for(const e of effects)scene.remove(e.mesh);

 zombies.length=0;
 bullets.length=0;
 effects.length=0;

 weapons[0].ammo=weapons[0].capacity;
 weapons[1].ammo=weapons[1].capacity;
 weapons[2].ammo=weapons[2].capacity;

 weaponIndex=0;
 fireCooldown=0;
 reloadTimer=0;
 spawnTimer=0;

 keys.w=keys.a=keys.s=keys.d=false;

 document.getElementById("overlay").style.display="none";

 spawnWave();
 updateHUD();
}

/* =========================
   KEYBOARD INPUT
========================= */

window.addEventListener("keydown",e=>{
 const k=e.key.toLowerCase();

 if(k in keys)keys[k]=true;

 if(k==="shift")sprinting=true;
 if(k===" ")shoot();
 if(k==="r")reload();
 if(k==="1")switchWeapon(0);
 if(k==="2")switchWeapon(1);
 if(k==="3")switchWeapon(2);
});

window.addEventListener("keyup",e=>{
 const k=e.key.toLowerCase();
 if(k in keys)keys[k]=false;
 if(k==="shift")sprinting=false;
});

renderer.domElement.addEventListener("pointerdown",()=>{
 if(running)shoot();
});

document.querySelectorAll("[data-key]").forEach(button=>{
 const key=button.dataset.key;

 button.addEventListener("pointerdown",e=>{
  e.preventDefault();
  keys[key]=true;
 });

 ["pointerup","pointerleave","pointercancel"].forEach(event=>{
  button.addEventListener(event,()=>keys[key]=false);
 });
});

document.querySelectorAll("[data-action]").forEach(button=>{
 button.addEventListener("pointerdown",e=>{
  e.preventDefault();
  const action=button.dataset.action;

  if(action==="shoot")shoot();
  if(action==="reload")reload();
  if(action==="sprint")sprinting=!sprinting;
  if(action==="switch")switchWeapon(weaponIndex+1);
 });
});

document.getElementById("startButton").addEventListener(
 "click",resetGame
);

/* =========================
   MAIN GAME LOOP
========================= */

function animate(){
 requestAnimationFrame(animate);

 const dt=Math.min(clock.getDelta(),.04);

 if(running&&!gameOver){
  movePlayer(dt);
  updateZombies(dt);
  updateBullets(dt);
  updateWaves(dt);
  updateEffects(dt);

  fireCooldown=Math.max(0,fireCooldown-dt);

  if(reloadTimer>0){
   reloadTimer-=dt;

   if(reloadTimer<=0){
    const w=currentWeapon();
    w.ammo=w.capacity;
    say("RELOAD COMPLETE!");
    updateHUD();
   }
  }

  if(messageTimer>0){
   messageTimer-=dt;
   if(messageTimer<=0){
    document.getElementById("message").style.opacity=0;
   }
  }

  updateCamera(dt);
 }else{
  updateCamera(dt);
 }

 renderer.render(scene,camera);
}

/* =========================
   RESIZE AND START
========================= */

window.addEventListener("resize",()=>{
 camera.aspect=innerWidth/innerHeight;
 camera.updateProjectionMatrix();
 renderer.setSize(innerWidth,innerHeight);
});

updateHUD();
animate();

</script>
</body>
</html>
